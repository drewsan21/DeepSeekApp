# =============================================================================
# DeepSeek Desktop — Comprehensive .gitignore
# =============================================================================

# Dependencies (reinstall with ./install.sh or install.bat)
node_modules/

# Local npm cache
.npm-cache/

# Build output
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swn
*.swp
*~
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Environment files
.env
.env.local
.env.*.local
.env.production
.env.development

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo

# Test coverage
coverage/
.nyc_output/

# Cache directories
.cache/
.eslintcache
.stylelintcache
.tsbuildinfo

# Misc
.vercel
.netlify
*.pem
*.key

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local config files
config.local.*
*.local.json
.next/
