{
  "name": "deepseek-desktop",
  "version": "0.1.0",
  "description": "DeepSeek Desktop — AI-powered desktop application",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "electron:dev": "NODE_ENV=development electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:preview": "electron .",
    "build:icons": "node scripts/convert-icons.js",
    "build:win": "node scripts/build-platform.js win",
    "build:linux": "node scripts/build-platform.js linux",
    "build:mac": "node scripts/build-platform.js mac",
    "build:all": "npm run build && electron-builder -mwl",
    "verify:build": "node scripts/verify-builds.js",
    "benchmark": "node scripts/run-benchmarks.js",
    "benchmark:baseline": "node scripts/run-benchmarks.js --baseline",
    "benchmark:compare": "node scripts/generate-performance-report.js",
    "benchmark:monitor": "node scripts/performance-monitor.js",
    "benchmark:report": "node scripts/generate-performance-report.js"
  },
  "build": {
    "appId": "com.deepseek.desktop",
    "productName": "DeepSeek Desktop",
    "copyright": "Copyright © 2024 DeepSeek",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.ts",
      "!**/*.tsx",
      "!node_modules/**/*.{md,txt,ts,tsx,js.map}"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "legalTrademarks": "DeepSeek",
      "publisherName": "DeepSeek",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "DeepSeek Desktop",
      "uninstallDisplayName": "DeepSeek Desktop",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutFolderName": "DeepSeek",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icons",
      "category": "Development",
      "synopsis": "DeepSeek Desktop - AI-powered development environment",
      "description": "DeepSeek Desktop is an AI-powered desktop application that combines multi-provider AI support, integrated browser automation, and enterprise-grade security.",
      "maintainer": "DeepSeek Team <support@deepseek.com>",
      "vendor": "DeepSeek",
      "packageCategory": "devel",
      "exec": "/opt/DeepSeek Desktop/deepseek-desktop",
      "desktop": {
        "Name": "DeepSeek Desktop",
        "Comment": "AI-powered development environment",
        "Terminal": "false",
        "Type": "Application",
        "Categories": "Development;IDE;"
      }
    },
    "deb": {
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "publish": null
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.98.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "axios": "^1.20.0",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "framer-motion": "^11.16.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "keytar": "^7.9.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "recharts": "^2.10.0",
    "ts-jest": "^29.4.14",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
