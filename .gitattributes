# =============================================================================
# DeepSeek Desktop — Git Attributes
# =============================================================================
# Handle line endings and file types for cross-platform compatibility

# Default to LF line endings for text files
* text=auto eol=lf

# Shell scripts must use LF
*.sh text eol=lf

# Batch files must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Ensure these are treated as text
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files should not be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Explicitly mark images as binary
*.bmp binary
*.tiff binary
*.webp binary

# Archives
*.zip binary
*.tar binary
*.gz binary
*.7z binary
*.rar binary

# Executables
*.exe binary
*.dll binary
*.so binary
*.dylib binary
